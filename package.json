{
  "name": "famac-visitacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visitação e prospecção comercial da FAMAC Acabamentos",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "start": "npm run dev",
    "build": "vite build && node scripts/check-client-secrets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --test scripts/domain.test.mjs scripts/policy.test.mjs scripts/architect-import.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "neon:client-env": "node scripts/neon-client-env.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:neon": "node --env-file=test-results/neon.env.local scripts/neon-e2e.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:cep": "node scripts/cep-ui.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.6.0-beta",
    "files-sdk": "^3.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^7.1.7"
  }
}
